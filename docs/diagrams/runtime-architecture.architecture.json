      "title": "During a session",
      "items": [
        "The browser polls the API's live tick: every 2s open, 60s shut",
        "The page re-renders every 60s; no card runs its own timer",
        "Slow feeds refresh on a background thread"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nightly job",
      "items": [
        "Backups, bars, research, paper book, audit",
        "Runs under caffeinate; the forward log is retried",
        "Irreplaceable rows are appended, never rewritten"
      ]
    },
    {
      "dot": "amber",
      "title": "Paid and outside calls",
      "items": [
        "Jev judges each headline once, in the nightly job",
        "Strategy fit asks Jev at most every 15 minutes",
        "Kite answers only after a login made in your browser"
      ]
